# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
venv/
.venv/
*.egg-info/

# Environment & Secrets
.env
.env.*
.streamlit/secrets.toml

# OS & Editor
.DS_Store
Thumbs.db
desktop.ini
