.idea/

# Data (never commit raw/processed datasets or runtime user logs)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
data/claims/predictions_log.csv
data/.keras/

# Production Models)
models/*
!models/.gitkeep
!models/*.json
!models/*.keras

# Report outline (personal/academic info)
docs/REPORT_OUTLINE.md
docs/synopsis.md

# Generated report figures (build artifacts)
reports/figures/*.png
reports/figures/*.json
!reports/figures/.gitkeep
